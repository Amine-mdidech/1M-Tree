# Unity generated folders
/Library/
/Temp/
/Obj/
/Logs/
/UserSettings/
/MemoryCaptures/
/Builds/

# Autogenerated project files
/*.csproj
/*.sln
/*.slnx
/*.suo
/*.user
/*.userprefs
/*.pidb
/*.booproj
/*.svd
/*.pdb
/*.mdb
/*.opendb
/*.VC.db

# Unity3D generated meta files that only matter locally
/sysinfo.txt

# macOS
.DS_Store

# Claude Code local runtime state
/.claude/settings.local.json
/.claude/scheduled_tasks.lock

# Local secrets (never commit API keys)
/.env.local

# Unity crash-recovery scene backups (auto-generated, not real work)
/Assets/_Recovery/
/Assets/_Recovery.meta

# Crashlytics generated file
crashlytics-build.properties
