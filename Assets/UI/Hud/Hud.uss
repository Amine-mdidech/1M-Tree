.hud-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

.top-left-cluster {
    position: absolute;
    top: var(--space-xl);
    left: var(--space-xl);
    flex-direction: row;
    align-items: center;
}

.currency-badge {
    height: 32px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(24, 20, 18, 0.82);
    -unity-background-scale-mode: stretch-to-fill;
    border-radius: var(--radius-pill);
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.16);
    padding: 0 var(--space-md) 0 var(--space-xs);
    opacity: 1;
    translate: 0 0;
    scale: 1 1;
    transition-property: opacity, translate, scale;
    transition-duration: 3.5s, 3.5s, 0.15s;
    transition-timing-function: ease-out-cubic, ease-out-cubic, ease-out;
}

.currency-badge--enter {
    opacity: 0;
    translate: -160px -120px;
}

.currency-badge--pulse {
    scale: 1.18 1.18;
}

.gem-float-label {
    position: absolute;
    top: 20px;
    left: 175px;
    color: var(--color-gold);
    font-size: var(--font-size-md);
    -unity-font-style: bold;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.75s;
    transition-timing-function: ease-out;
}

.gem-float-label--animate {
    opacity: 0;
    translate: 0 -28px;
}

.gem-icon {
    width: 16px;
    height: 16px;
    margin-right: var(--space-xs);
}

.gem-count-label {
    font-size: var(--font-size-xs);
    color: var(--text-on-dark);
    -unity-font-style: bold;
}

.xp-badge {
    height: 32px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(24, 20, 18, 0.82);
    -unity-background-scale-mode: stretch-to-fill;
    border-radius: var(--radius-pill);
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.16);
    padding: 0 var(--space-md) 0 var(--space-xs);
    margin-left: var(--space-sm);
}

.xp-icon {
    width: 16px;
    height: 16px;
    margin-right: var(--space-xs);
}

.xp-level-label {
    font-size: var(--font-size-xs);
    color: var(--text-on-dark);
    -unity-font-style: bold;
    margin-right: var(--space-xs);
    scale: 1 1;
    transition-property: scale;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.xp-level-label--punch {
    scale: 1.4 1.4;
}

.xp-bar-track {
    width: 60px;
    height: 6px;
    border-radius: var(--radius-pill);
    background-color: rgba(0, 0, 0, 0.4);
    overflow: hidden;
}

.xp-bar-fill {
    height: 100%;
    width: 0%;
    background-color: rgb(140, 89, 217);
    border-radius: var(--radius-pill);
    transition-property: width;
    transition-duration: 0.35s;
    transition-timing-function: ease-out;
}

.xp-bar-fill--flash {
    background-color: rgb(210, 180, 255);
}

.action-cluster {
    position: absolute;
    bottom: var(--space-xl);
    right: var(--space-xl);
    flex-direction: row;
    align-items: center;
    background-color: rgba(24, 20, 18, 0.82);
    border-radius: var(--radius-pill);
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.16);
    padding: var(--space-xs) var(--space-sm);
}

.icon-button {
    width: 26px;
    height: 26px;
    margin-left: var(--space-xs);
    padding: 0;
    border-radius: var(--radius-pill);
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.22);
    -unity-background-scale-mode: scale-to-fit;
}

.icon-button:hover {
    opacity: 0.9;
}

.icon-button:active {
    scale: 0.9 0.9;
}

.demo-icon-button {
    position: absolute;
    top: var(--space-xl);
    right: var(--space-xl);
    width: 40px;
    height: 40px;
    margin-left: 0;
    background-color: rgba(24, 20, 18, 0.82);
    border-color: rgba(255, 255, 255, 0.22);
    padding: var(--space-xs);
}

.vegetation-label {
    margin-right: var(--space-xs);
    padding: 3px var(--space-sm);
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: var(--radius-pill);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    color: var(--text-on-dark);
    font-size: var(--font-size-xs);
    -unity-font-style: bold;
}
