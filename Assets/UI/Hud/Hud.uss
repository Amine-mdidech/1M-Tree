.hud-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

.top-left-cluster {
    position: absolute;
    /* Explicit override (not --space-xl, shared by the other corner clusters) so this row alone
       sits closer to the top edge. */
    top: 10px;
    left: var(--space-xl);
    flex-direction: row;
    align-items: center;
}

/* Organic-design-system pill (see docs' Claude Design "Organic" project): a flat --color-surface
   pill instead of the dark brass-textured chrome the rest of the HUD uses - just these two
   currency badges plus .xp-badge below, per the requested 3-element redesign. */
.currency-badge {
    height: 32px;
    flex-direction: row;
    align-items: center;
    background-color: rgb(235, 221, 197);
    /* Rounded rectangle, not a full pill/oval - matches the "rectangular with a rounded corner"
       correction already established for the main menu buttons, over the design system's own
       generic .tag/.btn pill override. */
    border-radius: var(--radius-md);
    border-width: 0;
    padding: 0 var(--space-sm) 0 3px;
    opacity: 1;
    translate: 0 0;
    scale: 1 1;
    transition-property: opacity, translate, scale;
    transition-duration: 3.5s, 3.5s, 0.15s;
    transition-timing-function: ease-out-cubic, ease-out-cubic, ease-out;
}

#funds-badge {
    margin-left: var(--space-xs);
}

.picker-cluster {
    height: 26px;
    margin-left: var(--space-xs);
    flex-direction: row;
    align-items: center;
}

.currency-badge--enter {
    opacity: 0;
    translate: -160px -120px;
}

.currency-badge--pulse {
    scale: 1.18 1.18;
}

.gem-float-label {
    position: absolute;
    top: 16px;
    left: 155px;
    color: var(--color-gold);
    font-size: var(--font-size-md);
    -unity-font-style: bold;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.75s;
    transition-timing-function: ease-out;
}

.gem-float-label--animate {
    opacity: 0;
    translate: 0 -28px;
}

.funds-float-label {
    position: absolute;
    top: 16px;
    left: 235px;
    color: var(--color-gold);
    font-size: var(--font-size-md);
    -unity-font-style: bold;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.75s;
    transition-timing-function: ease-out;
}

.funds-float-label--animate {
    opacity: 0;
    translate: 0 -28px;
}

.gem-icon {
    width: 24px;
    height: 24px;
    margin-right: var(--space-xs);
}

.gem-count-label {
    font-size: var(--font-size-sm);
    color: rgb(32, 30, 29);
    -unity-font-definition: url("project://database/Assets/Fonts/Caprasimo-Regular.ttf");
}

.xp-badge {
    height: 32px;
    flex-direction: row;
    align-items: center;
    background-color: rgb(235, 221, 197);
    border-radius: var(--radius-md);
    border-width: 0;
    padding: 0 var(--space-sm) 0 3px;
    margin-left: var(--space-xs);
}

.xp-icon {
    width: 24px;
    height: 24px;
    margin-right: var(--space-xs);
}

.xp-level-label {
    font-size: var(--font-size-sm);
    color: rgb(32, 30, 29);
    -unity-font-definition: url("project://database/Assets/Fonts/Caprasimo-Regular.ttf");
    margin-right: var(--space-xs);
    scale: 1 1;
    transition-property: scale;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.xp-level-label--punch {
    scale: 1.4 1.4;
}

.xp-bar-track {
    width: 56px;
    height: 8px;
    border-radius: var(--radius-pill);
    border-width: 0;
    background-color: rgb(220, 211, 196);
    overflow: hidden;
}

.xp-bar-fill {
    height: 100%;
    width: 0%;
    -unity-background-scale-mode: stretch-to-fill;
    /* Slightly dimmed at rest so the flash class below (full white = no dimming) reads as a
       genuine brightening pop - a multiply-tint can only go as bright as the source texture
       itself (white = identity), so the "flash" has to start from a dimmed baseline. */
    -unity-background-image-tint-color: rgb(210, 200, 220);
    border-radius: var(--radius-pill);
    transition-property: width, -unity-background-image-tint-color;
    transition-duration: 0.35s, 0.15s;
    transition-timing-function: ease-out, ease-out;
}

/* Brightens the gradient texture (rather than swapping a flat color, now that the fill uses a
   generated gradient texture instead of a flat background-color) for the level-up flash pop. */
.xp-bar-fill--flash {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.action-cluster {
    position: absolute;
    bottom: var(--space-xl);
    right: var(--space-xl);
    flex-direction: row;
    align-items: center;
}

.icon-button {
    width: 26px;
    height: 26px;
    margin-left: var(--space-xs);
    padding: 0;
    border-radius: var(--radius-pill);
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.22);
    -unity-background-scale-mode: scale-to-fit;
}

.icon-button:hover {
    opacity: 0.9;
}

.icon-button:active {
    scale: 0.9 0.9;
}

.demo-icon-button {
    position: absolute;
    top: var(--space-xl);
    right: var(--space-xl);
    width: 40px;
    height: 40px;
    margin-left: 0;
    background-color: rgba(24, 20, 18, 0.82);
    border-color: rgba(255, 255, 255, 0.22);
    padding: var(--space-xs);
}

.minimap-cluster {
    position: absolute;
    bottom: var(--space-xl);
    left: var(--space-xl);
    flex-direction: column;
    align-items: center;
}

.minimap-view {
    width: 42px;
    height: 42px;
    border-radius: var(--radius-md);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.25);
    background-color: rgba(10, 12, 8, 0.6);
    -unity-background-scale-mode: stretch-to-fill;
}

.land-lock-popup-root {
    display: none;
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(6, 8, 14, 0.75);
    align-items: center;
    justify-content: center;
}

.land-lock-popup-frame {
    width: 300px;
    background-color: var(--color-ink);
    border-radius: var(--radius-lg);
    border-top-width: var(--border-thick);
    border-left-width: var(--border-thick);
    border-right-width: var(--border-shadow);
    border-bottom-width: var(--border-shadow);
    border-top-color: var(--color-gold-light);
    border-left-color: var(--color-gold-light);
    border-right-color: var(--color-shadow);
    border-bottom-color: var(--color-shadow);
    padding: var(--space-lg);
    align-items: center;
}

.land-lock-popup-title {
    font-size: var(--font-size-lg);
    color: var(--color-gold);
    -unity-font-style: bold;
    margin-bottom: var(--space-sm);
}

.land-lock-popup-message {
    font-size: var(--font-size-sm);
    color: var(--text-on-dark);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: var(--space-md);
}

.land-lock-popup-buttons {
    flex-direction: row;
}

.land-lock-unlock-button {
    margin-right: var(--space-sm);
    height: 32px;
    padding: 0 var(--space-md);
    border-radius: var(--radius-md);
    border-top-width: var(--border-thin);
    border-left-width: var(--border-thin);
    border-right-width: var(--border-thick);
    border-bottom-width: var(--border-thick);
    border-top-color: var(--color-success-light);
    border-left-color: var(--color-success-light);
    border-right-color: var(--color-shadow);
    border-bottom-color: var(--color-shadow);
    background-color: var(--color-success);
    color: var(--text-on-dark);
    font-size: var(--font-size-sm);
    -unity-font-style: bold;
}

.land-lock-unlock-button:active {
    scale: 0.95 0.95;
}

.land-lock-unlock-button--locked {
    border-top-color: var(--color-locked);
    border-left-color: var(--color-locked);
    background-color: var(--color-locked-dark);
    color: rgba(255, 255, 255, 0.5);
}

.land-lock-close-button {
    height: 32px;
    padding: 0 var(--space-md);
    border-radius: var(--radius-md);
    border-top-width: var(--border-thin);
    border-left-width: var(--border-thin);
    border-right-width: var(--border-thick);
    border-bottom-width: var(--border-thick);
    border-top-color: var(--color-neutral-light);
    border-left-color: var(--color-neutral-light);
    border-right-color: var(--color-shadow);
    border-bottom-color: var(--color-shadow);
    background-color: var(--color-neutral);
    color: var(--text-on-dark);
    font-size: var(--font-size-sm);
    -unity-font-style: bold;
}

.land-lock-close-button:active {
    scale: 0.95 0.95;
}

.picker-label {
    margin-right: var(--space-xs);
    padding: 2px var(--space-xs);
    background-color: rgba(0, 0, 0, 0.2);
    -unity-background-scale-mode: stretch-to-fill;
    border-radius: var(--radius-sm);
    border-width: 1px;
    border-color: var(--color-gold-light);
    color: var(--text-on-dark);
    font-size: var(--font-size-xs);
    -unity-font-style: bold;
}

/* Overrides .icon-button's pill radius (and, for this cluster specifically, its size - the top-left
   cluster is tight on horizontal space now that it holds two currency badges, an XP bar, and this
   picker) for this one icon. The other buttons sharing the base class (lab/codex/profile/settings/
   demo) are unaffected, since neither this radius nor this size change touches `.icon-button` itself. */
.picker-icon-button {
    width: 22px;
    height: 22px;
    border-radius: var(--radius-sm);
    border-width: var(--border-thin);
    border-color: var(--color-gold-light);
}

.move-tree-banner-root {
    display: none;
    position: absolute;
    top: var(--space-xl);
    width: 100%;
    align-items: center;
}

.move-tree-banner {
    flex-direction: row;
    align-items: center;
    background-color: rgba(24, 20, 18, 0.9);
    border-radius: var(--radius-pill);
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.2);
    padding: var(--space-xs) var(--space-sm);
}

.move-tree-banner-label {
    color: var(--text-on-dark);
    font-size: var(--font-size-sm);
    -unity-font-style: bold;
    margin-right: var(--space-sm);
}

.move-tree-cancel-button {
    height: 26px;
    padding: 0 var(--space-sm);
    border-radius: var(--radius-pill);
    border-top-width: var(--border-thin);
    border-left-width: var(--border-thin);
    border-right-width: var(--border-thick);
    border-bottom-width: var(--border-thick);
    border-top-color: var(--color-danger-light);
    border-left-color: var(--color-danger-light);
    border-right-color: var(--color-shadow);
    border-bottom-color: var(--color-shadow);
    background-color: var(--color-danger);
    color: var(--text-on-dark);
    font-size: var(--font-size-xs);
    -unity-font-style: bold;
}

.move-tree-cancel-button:active {
    scale: 0.95 0.95;
}

.cost-float-label {
    position: absolute;
    color: var(--color-danger-light);
    font-size: var(--font-size-md);
    -unity-font-style: bold;
    -unity-text-outline-width: 1;
    -unity-text-outline-color: var(--color-ink);
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.75s;
    transition-timing-function: ease-out;
}

.cost-float-label--animate {
    opacity: 0;
    translate: 0 -28px;
}
