<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/UI/Theme/Theme.uss" />
    <ui:Style src="project://database/Assets/UI/Hud/Hud.uss" />
    <ui:VisualElement name="hud-root" class="hud-root theme-scope" picking-mode="Ignore">
        <ui:VisualElement name="top-left-cluster" class="top-left-cluster">
            <ui:VisualElement name="currency-badge" class="currency-badge" picking-mode="Ignore">
                <ui:VisualElement name="gem-icon" class="gem-icon" picking-mode="Ignore">
                    <ui:VisualElement name="gem-icon-glyph" class="hud-icon-glyph" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="gem-count-label" text="0" class="gem-count-label" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="funds-badge" class="currency-badge" picking-mode="Ignore">
                <ui:VisualElement name="funds-icon" class="gem-icon" picking-mode="Ignore">
                    <ui:VisualElement name="funds-icon-glyph" class="hud-icon-glyph" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="funds-count-label" text="0" class="gem-count-label" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="xp-badge" class="xp-badge" picking-mode="Ignore">
                <ui:VisualElement name="xp-icon" class="xp-icon" picking-mode="Ignore">
                    <ui:VisualElement name="xp-icon-glyph" class="hud-icon-glyph" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="xp-level-label" text="Lv 1" class="xp-level-label" picking-mode="Ignore" />
                <ui:VisualElement name="xp-bar-track" class="xp-bar-track" picking-mode="Ignore">
                    <ui:VisualElement name="xp-bar-fill" class="xp-bar-fill" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="picker-cluster" class="picker-cluster">
                <ui:Button name="picker-button" class="icon-button picker-icon-button" />
                <ui:Button name="picker-label" text="Oak" class="picker-label" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button name="demo-button" class="icon-button demo-icon-button" />
        <ui:VisualElement name="move-tree-banner-root" class="move-tree-banner-root" picking-mode="Ignore">
            <ui:VisualElement name="move-tree-banner" class="move-tree-banner">
                <ui:Label name="move-tree-banner-label" text="" class="move-tree-banner-label" picking-mode="Ignore" />
                <ui:Button name="move-tree-cancel-button" text="Cancel" class="move-tree-cancel-button" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="action-cluster" class="action-cluster">
            <ui:Button name="lab-button" class="icon-button" />
            <ui:Button name="codex-button" class="icon-button" />
            <ui:Button name="profile-button" class="icon-button" />
            <ui:Button name="species-summary-button" class="icon-button" />
            <ui:Button name="store-button" class="icon-button" />
            <ui:Button name="settings-button" class="icon-button" />
        </ui:VisualElement>
        <ui:VisualElement name="minimap-cluster" class="minimap-cluster">
            <ui:VisualElement name="minimap-view" class="minimap-view" />
        </ui:VisualElement>
        <ui:VisualElement name="land-lock-popup-root" class="land-lock-popup-root">
            <ui:VisualElement name="land-lock-popup-frame" class="land-lock-popup-frame">
                <ui:Label text="Land Locked" class="land-lock-popup-title" />
                <ui:Label name="land-lock-popup-message" text="" class="land-lock-popup-message" />
                <ui:VisualElement class="land-lock-popup-buttons">
                    <ui:Button name="land-lock-unlock-button" text="Unlock" class="land-lock-unlock-button" />
                    <ui:Button name="land-lock-close-button" text="Close" class="land-lock-close-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
