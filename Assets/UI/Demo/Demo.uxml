<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/UI/Theme/Theme.uss" />
    <ui:Style src="project://database/Assets/UI/Demo/Demo.uss" />
    <ui:VisualElement name="demo-root" class="demo-root theme-scope">
        <ui:VisualElement name="demo-frame" class="demo-frame">
            <ui:VisualElement name="demo-header" class="demo-header">
                <ui:Label name="demo-title" text="Demo Tools" class="demo-title" />
                <ui:Button name="close-button" text="X" class="demo-close-button" />
            </ui:VisualElement>
            <ui:ScrollView name="demo-scroll" class="demo-scroll">
                <ui:Button name="add-gems-button" text="+100 Gems" class="demo-button" />
                <ui:Button name="unlock-species-button" text="Unlock All Species" class="demo-button" />
                <ui:Button name="unlock-vegetation-button" text="Unlock All Plants" class="demo-button" />
                <ui:Button name="finish-research-button" text="Finish Active Research" class="demo-button" />
                <ui:Button name="mature-trees-button" text="Mature All Trees" class="demo-button" />
                <ui:Button name="force-tick-button" text="Force Emergence Tick" class="demo-button" />
                <ui:Button name="plant-batch-button" text="Plant a Batch of Trees" class="demo-button" />
                <ui:Button name="reset-save-button" text="Delete Save (Reset Game)" class="demo-button demo-button-danger" />
            </ui:ScrollView>
            <ui:Label name="demo-status" text="Pick an action above." class="demo-status" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
