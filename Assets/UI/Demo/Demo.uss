.demo-root {
    width: 100%;
    height: 100%;
    background-color: rgba(12, 8, 15, 0.85);
    padding: var(--space-sm);
    align-items: center;
    justify-content: center;
}

.demo-frame {
    width: 100%;
    height: 100%;
    max-width: 480px;
    -unity-background-scale-mode: scale-and-crop;
    border-radius: var(--radius-lg);
    border-top-width: var(--border-thick);
    border-left-width: var(--border-thick);
    border-right-width: var(--border-shadow);
    border-bottom-width: var(--border-shadow);
    border-top-color: var(--color-gold-light);
    border-left-color: var(--color-gold-light);
    border-right-color: var(--color-shadow);
    border-bottom-color: var(--color-shadow);
    padding: var(--space-xs);
    transition-property: opacity, scale;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}

.demo-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: var(--surface-demo-border);
    border-radius: var(--radius-md);
    border-width: var(--border-thin);
    border-color: rgb(20, 21, 23);
    padding: var(--space-xs) var(--space-sm);
    margin-bottom: var(--space-xs);
    flex-shrink: 0;
}

.demo-title {
    font-size: var(--font-size-lg);
    color: rgb(230, 232, 234);
    -unity-font-style: bold;
    -unity-text-outline-width: 1;
    -unity-text-outline-color: var(--color-ink);
}

.demo-close-button {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-pill);
    border-top-width: var(--border-thin);
    border-left-width: var(--border-thin);
    border-right-width: var(--border-thick);
    border-bottom-width: var(--border-thick);
    border-top-color: var(--color-danger-light);
    border-left-color: var(--color-danger-light);
    border-right-color: var(--color-shadow);
    border-bottom-color: var(--color-shadow);
    background-color: var(--color-danger);
    color: var(--text-on-dark);
    font-size: var(--font-size-sm);
    -unity-font-style: bold;
}

.demo-close-button:active {
    scale: 0.92 0.92;
}

.demo-scroll {
    flex-grow: 1;
    -unity-background-scale-mode: scale-and-crop;
    border-radius: var(--radius-md);
    border-width: var(--border-thin);
    border-color: rgb(110, 114, 118);
    padding: var(--space-sm);
    margin-bottom: var(--space-xs);
}

.demo-button {
    min-height: 42px;
    margin-bottom: var(--space-sm);
    border-radius: var(--radius-md);
    border-top-width: var(--border-thin);
    border-left-width: var(--border-thin);
    border-right-width: var(--border-shadow);
    border-bottom-width: var(--border-shadow);
    border-top-color: var(--color-info-light);
    border-left-color: var(--color-info-light);
    border-right-color: var(--color-shadow);
    border-bottom-color: var(--color-shadow);
    background-color: var(--color-info);
    color: var(--text-on-dark);
    font-size: var(--font-size-sm);
    -unity-font-style: bold;
    -unity-text-outline-width: 1;
    -unity-text-outline-color: var(--color-ink);
}

.demo-button:active {
    scale: 0.96 0.96;
}

.demo-button-danger {
    background-color: var(--color-danger);
    border-top-color: var(--color-danger-light);
    border-left-color: var(--color-danger-light);
}

.demo-status {
    font-size: var(--font-size-sm);
    color: rgb(70, 72, 75);
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    padding: var(--space-xs);
}
