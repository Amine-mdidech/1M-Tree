<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/UI/Theme/Theme.uss" />
    <ui:Style src="project://database/Assets/UI/MainMenu/MainMenu.uss" />
    <ui:VisualElement name="menu-root" class="menu-root theme-scope">
        <ui:ScrollView name="menu-frame" class="menu-frame">
            <ui:Label name="menu-title" text="1M Trees" class="menu-title" />
            <ui:Button name="play-button" text="Play" class="menu-button" />
            <ui:Button name="new-game-button" text="New Game" class="menu-button" />
            <ui:VisualElement name="menu-footer" class="menu-footer">
                <ui:Button name="settings-button" text="Settings" class="menu-button menu-button-small" />
                <ui:Button name="quit-button" text="Quit" class="menu-button menu-button-small menu-button-last" />
            </ui:VisualElement>
        </ui:ScrollView>
        <ui:VisualElement name="confirm-root" class="confirm-root">
            <ui:VisualElement name="confirm-frame" class="confirm-frame">
                <ui:Label text="This will erase your current progress. Are you sure?" class="confirm-message" />
                <ui:VisualElement class="confirm-buttons">
                    <ui:Button name="confirm-yes-button" text="Erase and Start Over" class="menu-button menu-button-danger" />
                    <ui:Button name="confirm-no-button" text="Cancel" class="menu-button menu-button-last" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
