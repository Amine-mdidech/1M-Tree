.menu-root {
    width: 100%;
    height: 100%;
    background-color: var(--color-ink);
    padding: var(--space-xl);
    align-items: center;
    justify-content: center;
}

.menu-frame {
    width: 100%;
    max-width: 480px;
    max-height: 100%;
    padding: var(--space-lg);
    align-items: stretch;
}

.menu-title {
    font-size: var(--font-size-xl);
    color: var(--text-on-dark);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1;
    -unity-text-outline-color: var(--color-ink);
    margin-bottom: var(--space-md);
}

.menu-button {
    min-height: 42px;
    margin-bottom: var(--space-sm);
    border-radius: var(--radius-md);
    border-top-width: var(--border-thin);
    border-left-width: var(--border-thin);
    border-right-width: var(--border-shadow);
    border-bottom-width: var(--border-shadow);
    border-top-color: var(--color-success-light);
    border-left-color: var(--color-success-light);
    border-right-color: var(--color-shadow);
    border-bottom-color: var(--color-shadow);
    background-color: var(--color-success);
    color: var(--text-on-dark);
    font-size: var(--font-size-md);
    -unity-font-style: bold;
    -unity-text-outline-width: 1;
    -unity-text-outline-color: var(--color-ink);
}

.menu-button:active {
    scale: 0.96 0.96;
}

.menu-button-small {
    min-height: 32px;
    margin-right: var(--space-sm);
    font-size: var(--font-size-sm);
    flex-grow: 1;
}

.menu-button-danger {
    background-color: var(--color-danger);
    border-top-color: var(--color-danger-light);
    border-left-color: var(--color-danger-light);
}

.menu-footer {
    flex-direction: row;
    margin-bottom: 0;
}

.menu-footer .menu-button-small {
    margin-bottom: 0;
}

.menu-footer .menu-button-small.menu-button-last {
    margin-right: 0;
}

.confirm-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.7);
    align-items: center;
    justify-content: center;
}

.confirm-frame {
    width: 90%;
    max-width: 400px;
    background-color: var(--surface-demo);
    border-radius: var(--radius-lg);
    border-width: var(--border-thick);
    border-color: var(--color-danger-light);
    padding: var(--space-lg);
    transition-property: opacity, scale;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}

.confirm-message {
    color: var(--text-on-dark);
    font-size: var(--font-size-md);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: var(--space-lg);
}

.confirm-buttons {
    flex-direction: row;
}

.confirm-buttons .menu-button {
    flex-grow: 1;
    margin-right: var(--space-sm);
}

.confirm-buttons .menu-button-last {
    margin-right: 0;
}
