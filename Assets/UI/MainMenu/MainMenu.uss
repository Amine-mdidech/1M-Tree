.menu-root {
    width: 100%;
    height: 100%;
    background-color: rgb(42, 40, 30);
    align-items: center;
    justify-content: center;
}

.menu-frame {
    width: 100%;
    height: 100%;
    border-radius: 0;
    overflow: hidden;
    background-color: rgb(42, 40, 30);
    padding: 35px;
}

.menu-bg-pan {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

.menu-bg-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 160%;
    height: 100%;
    -unity-background-scale-mode: scale-and-crop;
    opacity: 0.5;
}

.menu-bg-scrim {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.menu-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.menu-pill {
    flex-direction: row;
    align-items: center;
    height: 54px;
    padding: 0 18px;
    border-radius: var(--radius-pill);
    background-color: rgba(20, 18, 14, 0.55);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.25);
}

.menu-pill-icon {
    width: 24px;
    height: 24px;
    margin-right: 6px;
}

.menu-pill-label {
    color: var(--text-on-dark);
    font-size: 20px;
    -unity-font-definition: url("project://database/Assets/Fonts/Caprasimo-Regular.ttf");
}

.menu-header-right {
    flex-direction: row;
    align-items: center;
}

.menu-header-right .menu-pill {
    margin-right: var(--space-sm);
}

.menu-icon-button {
    width: 54px;
    height: 54px;
    padding: 0;
    margin: 0;
    border-radius: var(--radius-pill);
    background-color: rgba(20, 18, 14, 0.55);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.25);
    align-items: center;
    justify-content: center;
}

.menu-icon-button:active {
    scale: 0.92 0.92;
}

.menu-icon-button-glyph {
    width: 27px;
    height: 27px;
}

.menu-title-area {
    align-items: center;
    margin-top: var(--space-xl);
}

.menu-title {
    font-size: 76px;
    color: rgb(250, 240, 230);
    -unity-font-definition: url("project://database/Assets/Fonts/Caprasimo-Regular.ttf");
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1;
    -unity-text-outline-color: var(--color-ink);
}

.menu-subtitle {
    font-size: 17px;
    color: rgb(212, 206, 196);
    -unity-font-definition: url("project://database/Assets/Fonts/Figtree-Regular.ttf");
    -unity-text-align: middle-center;
    margin-top: var(--space-xs);
}

.menu-spacer {
    flex-grow: 1;
}

.menu-button-row {
    flex-direction: row;
    align-items: center;
}

.menu-button {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-height: 60px;
    padding: 0 var(--space-xl);
    margin-right: var(--space-sm);
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    background-color: rgba(0, 0, 0, 0);
    color: var(--text-on-dark);
    font-size: var(--font-size-lg);
    -unity-font-definition: url("project://database/Assets/Fonts/Caprasimo-Regular.ttf");
}

.menu-button:active {
    scale: 0.97 0.97;
}

.menu-button-icon {
    width: 22px;
    height: 22px;
    margin-right: var(--space-sm);
}

.menu-button-primary {
    background-color: rgb(122, 148, 95);
    border-color: rgb(122, 148, 95);
}

.menu-button-secondary {
    background-color: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.35);
}

.menu-button-ghost {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    margin-left: auto;
    margin-right: 0;
    padding: 0 var(--space-sm);
    color: var(--color-danger-light);
}

.menu-button-ghost .menu-button-icon {
    -unity-background-image-tint-color: var(--color-danger-light);
}

.menu-button-danger {
    background-color: var(--color-danger);
    border-color: var(--color-danger-light);
}

.menu-button-last {
    margin-right: 0;
}

.confirm-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.7);
    align-items: center;
    justify-content: center;
}

.confirm-frame {
    width: 90%;
    max-width: 400px;
    background-color: rgb(42, 40, 30);
    border-radius: var(--radius-lg);
    border-width: var(--border-thick);
    border-color: var(--color-danger-light);
    padding: var(--space-lg);
    transition-property: opacity, scale;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}

.confirm-message {
    color: var(--text-on-dark);
    font-size: var(--font-size-md);
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Fonts/Figtree-Regular.ttf");
    -unity-text-align: middle-center;
    margin-bottom: var(--space-lg);
}

.confirm-buttons {
    flex-direction: row;
}

.confirm-buttons .menu-button {
    flex-grow: 1;
}
