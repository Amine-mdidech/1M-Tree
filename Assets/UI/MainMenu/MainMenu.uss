.menu-root {
    width: 100%;
    height: 100%;
    background-color: var(--surface-menu-inner);
    padding: var(--space-xl);
    align-items: center;
    justify-content: center;
}

.menu-frame {
    width: 100%;
    height: 100%;
    max-width: 480px;
    background-color: var(--surface-menu);
    border-radius: var(--radius-lg);
    border-top-width: var(--border-thick);
    border-left-width: var(--border-thick);
    border-right-width: var(--border-shadow);
    border-bottom-width: var(--border-shadow);
    border-top-color: var(--color-gold-light);
    border-left-color: var(--color-gold-light);
    border-right-color: var(--surface-menu-border);
    border-bottom-color: var(--surface-menu-border);
    padding: var(--space-lg);
    align-items: stretch;
}

.menu-title {
    font-size: var(--font-size-xl);
    color: var(--text-on-dark);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1;
    -unity-text-outline-color: var(--color-ink);
    margin-bottom: var(--space-md);
}

.menu-stat {
    font-size: var(--font-size-md);
    color: var(--text-on-dark);
    -unity-text-align: middle-center;
    margin-bottom: var(--space-lg);
}

.menu-button {
    min-height: 42px;
    margin-bottom: var(--space-sm);
    border-radius: var(--radius-md);
    border-top-width: var(--border-thin);
    border-left-width: var(--border-thin);
    border-right-width: var(--border-shadow);
    border-bottom-width: var(--border-shadow);
    border-top-color: var(--color-success-light);
    border-left-color: var(--color-success-light);
    border-right-color: var(--color-shadow);
    border-bottom-color: var(--color-shadow);
    background-color: var(--color-success);
    color: var(--text-on-dark);
    font-size: var(--font-size-md);
    -unity-font-style: bold;
    -unity-text-outline-width: 1;
    -unity-text-outline-color: var(--color-ink);
}

.menu-button:active {
    scale: 0.96 0.96;
}

.menu-button-small {
    min-height: 32px;
    font-size: var(--font-size-sm);
    flex-grow: 1;
}

.menu-button-danger {
    background-color: var(--color-danger);
    border-top-color: var(--color-danger-light);
    border-left-color: var(--color-danger-light);
}

.menu-section-title {
    font-size: var(--font-size-md);
    color: var(--text-on-dark);
    -unity-font-style: bold;
    margin-top: var(--space-md);
    margin-bottom: var(--space-sm);
}

.menu-milestones-scroll {
    flex-grow: 1;
    border-radius: var(--radius-md);
    border-width: var(--border-thin);
    border-color: var(--surface-menu-border);
    padding: var(--space-sm);
    margin-bottom: var(--space-md);
}

.menu-milestone-row {
    flex-direction: row;
    justify-content: space-between;
    padding: var(--space-xs) var(--space-sm);
    margin-bottom: var(--space-xs);
    border-radius: var(--radius-sm);
    background-color: rgba(255, 255, 255, 0.08);
}

.menu-milestone-requirement {
    color: var(--text-on-dark);
    font-size: var(--font-size-sm);
}

.menu-milestone-reward {
    color: var(--color-gold-light);
    font-size: var(--font-size-sm);
    -unity-font-style: bold;
}

.menu-footer {
    flex-direction: row;
}

.confirm-root {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.7);
    align-items: center;
    justify-content: center;
}

.confirm-frame {
    width: 90%;
    max-width: 400px;
    background-color: var(--surface-menu);
    border-radius: var(--radius-lg);
    border-width: var(--border-thick);
    border-color: var(--color-danger-light);
    padding: var(--space-lg);
    transition-property: opacity, scale;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}

.confirm-message {
    color: var(--text-on-dark);
    font-size: var(--font-size-md);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: var(--space-lg);
}

.confirm-buttons {
    flex-direction: row;
}

.confirm-buttons .menu-button {
    flex-grow: 1;
    margin-right: var(--space-sm);
}

.confirm-buttons .menu-button:last-child {
    margin-right: 0;
}
