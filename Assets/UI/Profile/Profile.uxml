<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/UI/Theme/Theme.uss" />
    <ui:Style src="project://database/Assets/UI/Profile/Profile.uss" />
    <ui:VisualElement name="profile-root" class="profile-root theme-scope">
        <ui:VisualElement name="profile-frame" class="profile-frame">
            <ui:VisualElement name="profile-header" class="profile-header">
                <ui:Label name="profile-title" text="Profile" class="profile-title" />
                <ui:Button name="close-button" text="X" class="profile-close-button" />
            </ui:VisualElement>
            <ui:ScrollView name="profile-content" class="profile-content">
                <ui:VisualElement class="stat-card">
                    <ui:VisualElement name="level-icon" class="stat-icon" />
                    <ui:Label text="Level" class="stat-label" />
                    <ui:Label name="level-value" text="1" class="stat-value" />
                </ui:VisualElement>
                <ui:VisualElement class="stat-card">
                    <ui:VisualElement name="land-icon" class="stat-icon" />
                    <ui:Label text="Land Unlocked" class="stat-label" />
                    <ui:Label name="land-value" text="1 / 1" class="stat-value" />
                </ui:VisualElement>
                <ui:VisualElement class="stat-card">
                    <ui:VisualElement name="gems-icon" class="stat-icon" />
                    <ui:Label text="Gems" class="stat-label" />
                    <ui:Label name="gems-value" text="0" class="stat-value" />
                </ui:VisualElement>
                <ui:VisualElement class="stat-card">
                    <ui:VisualElement name="trees-icon" class="stat-icon" />
                    <ui:Label text="Trees Planted" class="stat-label" />
                    <ui:Label name="trees-value" text="0" class="stat-value" />
                </ui:VisualElement>
                <ui:VisualElement class="stat-card">
                    <ui:VisualElement name="species-icon" class="stat-icon" />
                    <ui:Label text="Species Unlocked" class="stat-label" />
                    <ui:Label name="species-value" text="0 / 0" class="stat-value" />
                </ui:VisualElement>
                <ui:VisualElement class="stat-card">
                    <ui:VisualElement name="vegetation-icon" class="stat-icon" />
                    <ui:Label text="Plants Unlocked" class="stat-label" />
                    <ui:Label name="vegetation-value" text="0 / 0" class="stat-value" />
                </ui:VisualElement>
                <ui:VisualElement class="stat-card">
                    <ui:VisualElement name="milestones-icon" class="stat-icon" />
                    <ui:Label text="Milestones" class="stat-label" />
                    <ui:Label name="milestones-value" text="0 / 0" class="stat-value" />
                </ui:VisualElement>
                <ui:VisualElement class="stat-card">
                    <ui:VisualElement name="daily-cap-icon" class="stat-icon" />
                    <ui:Label text="Today's Planting" class="stat-label" />
                    <ui:Label name="daily-cap-value" text="0 / 0" class="stat-value" />
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
