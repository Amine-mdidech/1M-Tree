/*
 * Grove UI design tokens — single source of truth for color, spacing, radius,
 * border, and typography values used across every panel (Hud, Codex,
 * Laboratory, TreeBoost, Profile, Demo). Attach this stylesheet to a UXML
 * root BEFORE the panel's own local stylesheet so local rules can reference
 * these custom properties via var(--token-name).
 *
 * Panels are separate UIDocuments/PanelSettings, so this file must be
 * imported into every panel's UXML individually — custom properties inherit
 * down the visual tree, not across panels.
 *
 * Visual language: chunky mobile-game ("Clash of Clans"-inspired, not a
 * copy) — every panel/button is beveled (lighter border on top/left, darker
 * on bottom/right, thicker on the bottom/right edge to read as a drop
 * shadow), bold white text with a dark outline, and textured panel
 * backgrounds (wood/parchment/stone, generated by PixelArtUtility) instead
 * of flat fills.
 */

.theme-scope {
    /* --- Brand palette --- */
    --color-gold: rgb(255, 205, 70);
    --color-gold-light: rgb(255, 235, 160);
    --color-gold-dark: rgb(150, 100, 25);
    --color-ink: rgb(24, 17, 13);
    --color-shadow: rgb(18, 12, 9);

    /* --- Semantic action colors (base / light bevel / dark bevel) --- */
    --color-success: rgb(70, 165, 70);
    --color-success-light: rgb(130, 215, 115);
    --color-success-dark: rgb(25, 85, 35);
    --color-danger: rgb(215, 70, 55);
    --color-danger-light: rgb(245, 130, 105);
    --color-danger-dark: rgb(115, 30, 25);
    --color-info: rgb(30, 135, 155);
    --color-info-light: rgb(100, 195, 210);
    --color-info-dark: rgb(10, 60, 75);
    --color-neutral: rgb(175, 115, 55);
    --color-neutral-light: rgb(225, 170, 100);
    --color-neutral-dark: rgb(85, 50, 20);

    /* --- Panel surface colors (per feature, for visual identity) --- */
    --surface-codex: rgb(196, 150, 92);
    --surface-codex-inner: rgb(238, 222, 188);
    --surface-codex-border: rgb(90, 55, 25);
    --surface-lab: rgb(70, 140, 145);
    --surface-lab-inner: rgb(220, 240, 238);
    --surface-lab-border: rgb(15, 65, 70);
    --surface-treeboost: rgb(100, 150, 75);
    --surface-treeboost-inner: rgb(228, 240, 210);
    --surface-treeboost-border: rgb(45, 85, 35);
    --surface-profile: rgb(150, 110, 55);
    --surface-profile-inner: rgb(244, 230, 200);
    --surface-profile-border: rgb(70, 45, 20);
    --surface-demo: rgb(90, 95, 100);
    --surface-demo-inner: rgb(225, 227, 229);
    --surface-demo-border: rgb(35, 37, 40);

    /* --- Text colors --- */
    --text-on-dark: rgb(255, 255, 255);
    --text-on-gold: rgb(55, 36, 20);
    --text-muted: rgb(95, 65, 40);

    /* --- Locked/disabled state --- */
    --color-locked: rgb(95, 95, 95);
    --color-locked-dark: rgb(45, 45, 45);

    /* --- Spacing scale (4px base grid) --- */
    --space-xs: 4px;
    --space-sm: 8px;
    --space-md: 12px;
    --space-lg: 16px;
    --space-xl: 24px;

    /* --- Corner radius scale --- */
    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 18px;
    --radius-pill: 999px;

    /* --- Border widths --- */
    --border-thin: 2px;
    --border-thick: 4px;
    --border-shadow: 6px;

    /* --- Typography scale --- */
    --font-size-xs: 11px;
    --font-size-sm: 13px;
    --font-size-md: 15px;
    --font-size-lg: 18px;
    --font-size-xl: 24px;
}

/*
 * Shared open/close pop animation for full-screen panels (Codex/Laboratory/Profile/Demo). Each
 * panel's own -frame class must declare `scale: 1 1; opacity: 1;` plus a matching
 * transition-property so toggling this class animates instead of snapping.
 */
.panel-enter {
    opacity: 0;
    scale: 0.88 0.88;
}
